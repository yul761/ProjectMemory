generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStage {
  idea
  build
  test
  launch
}

enum MemoryType {
  stream
  document
}

enum MemorySource {
  telegram
  cli
  api
  sdk
}

enum ReminderStatus {
  scheduled
  sent
  cancelled
}

model User {
  id             String   @id @default(uuid())
  identity       String   @unique
  telegramUserId String?  @unique
  createdAt      DateTime @default(now())
  // The tenant's profile-facet ontology. NULL = use the deployment default pack.
  // A cloud account maps 1:1 onto a core user (the gateway forwards accountId as
  // x-user-id), so "per customer" and "per user" are the same thing here.
  facetPack      Json?

  scopes    ProjectScope[]
  state     UserState?
  memories  MemoryEvent[]
  reminders Reminder[]
}

model ProjectScope {
  id        String       @id @default(uuid())
  userId    String
  name      String
  goal      String?
  stage     ProjectStage @default(idea)
  createdAt DateTime     @default(now())

  template             String  @default("project")
  notificationWebhook  String?

  user         User                  @relation(fields: [userId], references: [id])
  memories     MemoryEvent[]
  digests      Digest[]
  digestStates DigestStateSnapshot[]
  workingMemory WorkingMemorySnapshot?
  reminders    Reminder[]
  userStates   UserState[]

  @@index([userId])
}

model UserState {
  userId          String  @id
  activeProjectId String?

  user          User          @relation(fields: [userId], references: [id])
  activeProject ProjectScope? @relation(fields: [activeProjectId], references: [id], onDelete: SetNull)
}

model MemoryEvent {
  id          String       @id @default(uuid())
  userId      String
  scopeId     String
  type        MemoryType
  source      MemorySource @default(api)
  key         String?
  content     String
  contentHash String?
  chatId      String?
  messageId   String?
  // When the event happened. Ingest overwrites this with `occurredAt` when the
  // caller supplies one, so it answers "when", not "when did we learn it".
  createdAt   DateTime     @default(now())
  // When we learned it. Never overwritten, so a window over "what is new to us"
  // stays answerable after history has been backfilled.
  ingestedAt  DateTime     @default(now())
  updatedAt   DateTime?

  classifiedType        String?
  classifiedImportance  Float?
  expiresAt             DateTime?
  suppressedAt          DateTime?
  // Caller-declared "must not lose a budget competition". The engine cannot tell
  // a resume from a meeting note, and its only other tiebreaker is recency —
  // which drops durable inputs first.
  pinned                Boolean      @default(false)

  user      User         @relation(fields: [userId], references: [id])
  scope     ProjectScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  embedding MemoryEventEmbedding?

  @@unique([scopeId, key])
  @@index([userId, scopeId, createdAt])
  @@index([scopeId, key])
  @@index([expiresAt])
}

model Digest {
  id             String   @id @default(uuid())
  scopeId        String
  summary        String
  changes        String
  nextSteps      Json
  // What the selection stage kept, and what it discarded and why. Nullable:
  // digests written before this column existed have no log, which is distinct
  // from "this run discarded nothing".
  selectionLog   Json?
  rebuildGroupId String?
  createdAt      DateTime @default(now())

  scope          ProjectScope        @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  stateSnapshot  DigestStateSnapshot?

  @@index([scopeId, createdAt])
  @@index([scopeId, rebuildGroupId])
}

model DigestStateSnapshot {
  id          String   @id @default(uuid())
  scopeId     String
  digestId    String   @unique
  state       Json
  consistency Json?
  createdAt   DateTime @default(now())

  scope  ProjectScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  digest Digest       @relation(fields: [digestId], references: [id], onDelete: Cascade)

  @@index([scopeId, createdAt])
}

model WorkingMemorySnapshot {
  id        String   @id @default(uuid())
  scopeId    String   @unique
  version    Int      @default(1)
  state      Json
  view       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scope ProjectScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([scopeId, updatedAt])
}

model Reminder {
  id        String         @id @default(uuid())
  userId    String
  scopeId   String?
  dueAt     DateTime
  text      String
  status    ReminderStatus @default(scheduled)
  createdAt DateTime       @default(now())

  user  User          @relation(fields: [userId], references: [id])
  scope ProjectScope? @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

model DigestJobLog {
  id           String   @id @default(uuid())
  scopeId      String
  jobId        String?
  status       String
  durationMs   Int?
  error        String?
  driftMetrics Json?
  completedAt  DateTime @default(now())

  @@index([scopeId, completedAt])
  @@index([status])
}

model MemoryEventEmbedding {
  eventId   String      @id
  model     String
  createdAt DateTime    @default(now())
  event     MemoryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model ForgottenFact {
  id              String   @id @default(uuid())
  userId          String
  scopeId         String
  factKey         String
  contentSnapshot String
  forgottenAt     DateTime @default(now())

  @@unique([scopeId, factKey])
  @@index([userId, scopeId])
}
