{
  "name": "@statecore/db",
  "version": "1.3.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma": "prisma",
    "seed": "tsx src/seed.ts",
    "generate:lite": "prisma generate --schema=prisma/schema.lite.prisma",
    "push:lite": "prisma db push --schema=prisma/schema.lite.prisma"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
